# ==============================
# AI Provider Switch
# ==============================
# "ollama" = local models on your own machine (default)
# "gemini" = free Google Gemini API (use this for free cloud hosting)
AI_PROVIDER=ollama

# ==============================
# Ollama Configuration (used when AI_PROVIDER=ollama)
# ==============================
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TIMEOUT_SECONDS=180

# ==============================
# Gemini Configuration (used when AI_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/apikey
# ==============================
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
GEMINI_EMBED_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=60

# ==============================
# Qdrant Configuration
# Local: leave QDRANT_URL empty, use host/port below.
# Qdrant Cloud (free): set QDRANT_URL + QDRANT_API_KEY, host/port are ignored.
# ==============================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=documents
QDRANT_VECTOR_SIZE=1024

# ==============================
# Memory Backend Switch
# ==============================
# "redis" = use Redis/Upstash for chat memory, document catalog, and cache (default)
# "memory" = keep everything in RAM instead -- no Redis/Upstash needed at all,
#            but history/catalog/cache reset whenever the app restarts
MEMORY_BACKEND=redis

# ==============================
# Redis Configuration
# Local: leave REDIS_URL empty, use host/port below.
# Upstash / Redis Cloud (free): set REDIS_URL instead, e.g.
#   rediss://default:PASSWORD@your-host.upstash.io:6379
# ==============================
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CONVERSATION_TTL_SECONDS=604800

# ==============================
# Chunking Configuration
# ==============================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==============================
# RAG Configuration
# ==============================
RAG_TOP_K=5
# Minimum similarity score (0-1) a chunk must hit to be treated as a real match.
# Small talk (hi/thanks/bye) is filtered out before it ever reaches this threshold
# (see app/utils/chitchat_utils.py), so this value only needs to catch genuinely
# irrelevant questions -- it does not need to be raised to block greetings.
# 0.3 matches what worked in real testing against this project's actual documents:
# well-phrased questions scored ~0.47-0.50, but short/vague phrasing (e.g. "how
# many years experience" vs. "how many years of experience does he have") can
# score lower, so keep this well below your typical real-match score rather than
# close to it. Check the "match %" shown under each answer's sources to see what
# your own documents actually score, and tune from there if needed.
RAG_SCORE_THRESHOLD=0.3

# ==============================
# App Configuration
# ==============================
APP_NAME=AI RAG Agent
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=../documents
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,null
